{
  "repositories": [
    {
      "id": "example-app",
      "path": "/absolute/path/to/example-app",
      "taskPrefix": "APP",
      "taskResolver": {
        "kind": "file",
        "path": "docs/tasks",
        "pattern": "{id}-*.md"
      },
      "validation": [
        "npm run typecheck",
        "npm test"
      ],
      "androidBuild": "npm run build:android:local",
      "guidance": [
        "AGENTS.md"
      ],
      "pilotEvidence": "docs/tasks/index.md",
      "taskTracking": "docs/tasks/index.md",
      "taskEvidenceDir": "docs/tasks/evidence",
      "commandTimeoutMs": 1800000,
      "providerTimeoutMs": 3600000,
      "closureGateScope": "all",
      "allowLockfileChanges": false
    }
  ]
}
